rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function hasUserDoc() {
      return isAuthenticated() && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isActive() {
      return isAuthenticated() && (
        (hasUserDoc() && getUserData().get('isActive', true) == true) ||
        // Allow institutional principal by email during setup
        (request.auth.token.email.lower() == 'pradeep4045t7@gmail.com')
      );
    }

    function isPrincipal() {
      return isAuthenticated() && (
        (hasUserDoc() && getUserData().get('role', '') == 'principal') ||
        (request.auth.token.email.lower() == 'pradeep4045t7@gmail.com')
      );
    }

    function isHOD(departmentId) {
      return isActive() && hasUserDoc() &&
        getUserData().get('role', '') == 'hod' &&
        getUserData().get('departmentId', '') == departmentId;
    }

    function isSelf(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // 1. Users collection
    match /users/{userId} {
      // Principal can read all users; Department members can read colleagues; Self can read self
      allow read: if isAuthenticated() && (
        isPrincipal() ||
        (hasUserDoc() && getUserData().get('departmentId', '') == resource.data.get('departmentId', '')) ||
        isSelf(userId)
      );

      // Create: Principal, HOD creating faculty in own department, or self during initial account setup
      allow create: if isPrincipal() || isSelf(userId) || (
        isActive() && hasUserDoc() && getUserData().get('role', '') == 'hod' &&
        request.resource.data.role == 'faculty' &&
        request.resource.data.departmentId == getUserData().get('departmentId', '')
      );

      // Update: Principal, HOD updating departmental faculty, or self updating permitted fields
      allow update: if isPrincipal() || (
        isActive() && hasUserDoc() && getUserData().get('role', '') == 'hod' &&
        resource.data.role == 'faculty' &&
        resource.data.departmentId == getUserData().get('departmentId', '') &&
        request.resource.data.role == 'faculty'
      ) || (
        isSelf(userId) &&
        request.resource.data.role == resource.data.role &&
        request.resource.data.departmentId == resource.data.departmentId &&
        request.resource.data.isActive == resource.data.isActive
      );

      // Deactivate accounts only, never hard delete (Section 6)
      allow delete: if false;
    }

    // 2. Departments collection
    match /departments/{departmentId} {
      allow read: if isAuthenticated();
      allow write: if isPrincipal();
    }

    // 3. Daily Logs Collection (Document ID: facultyId_YYYY-MM-DD)
    match /dailyLogs/{logId} {
      allow read: if isAuthenticated() && (
        isPrincipal() ||
        (isActive() && hasUserDoc() && getUserData().get('role', '') == 'hod' && resource.data.departmentId == getUserData().get('departmentId', '')) ||
        (isActive() && resource.data.facultyId == request.auth.uid)
      );

      // Create: Principal or Faculty for themselves (as draft or submitted)
      allow create: if isActive() && (
        isPrincipal() ||
        (request.resource.data.facultyId == request.auth.uid &&
         request.resource.data.submissionStatus in ['draft', 'submitted'])
      );

      // Update:
      // - Principal can review any log
      // - HOD can approve/return logs in their department (cannot approve their own log)
      // - Faculty can update their own log if not yet approved
      allow update: if isAuthenticated() && (
        isPrincipal() ||
        (isActive() && hasUserDoc() && getUserData().get('role', '') == 'hod' &&
         resource.data.departmentId == getUserData().get('departmentId', '') &&
         resource.data.facultyId != request.auth.uid &&
         request.resource.data.submissionStatus in ['approved', 'returned_for_correction', 'under_review']) ||
        (isActive() && resource.data.facultyId == request.auth.uid &&
         resource.data.submissionStatus != 'approved' &&
         request.resource.data.submissionStatus in ['draft', 'submitted'])
      );

      allow delete: if false;
    }

    // 4. Timetables & Allocations
    match /timetables/{timetableId} {
      allow read: if isAuthenticated();
      allow write: if isPrincipal() || (
        isActive() && hasUserDoc() && getUserData().get('role', '') == 'hod' &&
        request.resource.data.departmentId == getUserData().get('departmentId', '')
      );
    }

    // 5. Holidays & Academic Calendar
    match /holidays/{holidayId} {
      allow read: if isAuthenticated();
      allow write: if isPrincipal();
    }

    // 6. Leave & On-Duty Records
    match /leaveRecords/{leaveId} {
      allow read: if isAuthenticated() && (
        isPrincipal() ||
        (isActive() && hasUserDoc() && getUserData().get('role', '') == 'hod' && resource.data.departmentId == getUserData().get('departmentId', '')) ||
        resource.data.facultyId == request.auth.uid
      );
      allow write: if isPrincipal() || (
        isActive() && hasUserDoc() && getUserData().get('role', '') == 'hod' &&
        request.resource.data.departmentId == getUserData().get('departmentId', '')
      );
    }

    // 7. College Settings & Timings
    match /collegeSettings/{settingId} {
      allow read: if isAuthenticated();
      allow write: if isPrincipal();
    }

    // 8. Announcements
    match /announcements/{announcementId} {
      allow read: if isAuthenticated();
      allow create, update: if isPrincipal() || (
        isActive() && hasUserDoc() && getUserData().get('role', '') == 'hod'
      );
      allow delete: if isPrincipal();
    }

    // 9. Substitution Exchange Marketplace
    match /substitutions/{subId} {
      allow read: if isAuthenticated();
      allow create: if isActive();
      allow update: if isAuthenticated() && (
        isPrincipal() ||
        (hasUserDoc() && getUserData().get('role', '') == 'hod' && resource.data.departmentId == getUserData().get('departmentId', '')) ||
        resource.data.facultyId == request.auth.uid ||
        request.resource.data.claimedBy == request.auth.uid
      );
      allow delete: if isPrincipal() || (resource.data.facultyId == request.auth.uid && resource.data.status == 'open');
    }

    // 10. Syllabus & Course Outcomes Progress
    match /syllabusProgress/{progressId} {
      allow read: if isAuthenticated();
      allow write: if isActive();
    }

    // 11. Audit Logs (Append-only)
    match /auditLogs/{logId} {
      allow read: if isPrincipal();
      allow create: if isAuthenticated();
      allow update, delete: if false;
    }
  }
}
